{
  "schemaVersion": 1,
  "id": "garb",
  "version": "${version}",
  "name": "Garb",
  "description": "Select a class!",
  "authors": [
    "Globox_Z"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/garb",
    "sources": "https://github.com/Globox1997/Garb",
    "issues": "https://github.com/Globox1997/Garb/issues"
  },
  "license": "MIT",
  "icon": "assets/garb/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.garb.GarbMain"
    ],
    "client": [
      "net.garb.GarbClient"
    ],
    "modmenu": [
      "net.garb.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "garb.mixins.json"
  ],
  "depends": {
    "java": ">=21",
    "minecraft": ">=${minecraft_version}",
    "fabric-api": ">=${fabric_version}",
    "fabricloader": ">=${loader_version}",
    "cloth-config2": ">=${cloth_config_version}"
  },
  "custom": {
    "mc-publish": {
      "modrinth": "X",
      "curseforge": 0
